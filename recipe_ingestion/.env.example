# Ollama server URL. Default is fine for a local install; point this at a
# remote box's IP:11434 if you run Ollama on another machine (e.g. the
# headless Proxmox/Pavilion server) instead of locally.
OLLAMA_HOST=http://localhost:11434

# Model tag as pulled via `ollama pull <tag>`. gemma4:e2b is Google's
# smaller edge variant (~7GB quantized) -- swap to gemma4:e4b for more
# capability at the cost of a larger download/more RAM.
OLLAMA_MODEL=gemma4:e2b

# Where ingested recipe JSON files are written, under <OUTPUT_DIR>/recipes/
OUTPUT_DIR=./output

# Generation knobs for the structuring step (mapped to Ollama's num_predict/temperature).
MAX_NEW_TOKENS=4096

# Let thinking models (gemma4) reason before answering. Off by default: the hidden
# reasoning is slow and eats into MAX_NEW_TOKENS, which can truncate the JSON.
OLLAMA_THINK=false
LLM_TEMPERATURE=0.2
