PORT=4000
DB_PATH=./data/menu_suggestor.db

# In-app recipe import (Manage -> + Add Meal -> paste text / link) runs the
# Python recipe_ingestion tool. Defaults to ../recipe_ingestion/.venv/bin/python.
# RECIPE_INGEST_PYTHON=/path/to/python
# Local LLM extraction can be slow on CPU; default is 300000 (5 min).
# RECIPE_INGEST_TIMEOUT_MS=300000
